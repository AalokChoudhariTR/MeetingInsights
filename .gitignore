## Ignore Visual Studio temporary files, build results, and files generated by popular add-ons
# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.env
# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Bb]in/
[Oo]bj/
# Visual Studio cache/options directory
vs/
.vs
.vs/
# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
# Files built by Visual Studio
*.obj
*.pch
*.pdb
*.ipdb
*.log
*.tlog
*.tmp
*.tmp_proj
*.vspscc
*.vssscc
# ReSharper files
_ReSharper*/
*.DotSettings.user
# NuGet packages
*.nupkg
**/packages/*
!**/packages/build/
# Azure build outputs
csx/
*.build.csdef
# Node.js modules
node_modules/
# SQL Server files
*.mdf
*.ldf
# Others
*.dbmdl
*.publishsettings
*.pfx
# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

